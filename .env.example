# =============================================================================
#  .env.example - Hub Auditoria San Paolo
# =============================================================================
#  ESTE ARQUIVO E SO DOCUMENTACAO. A Vercel NAO le .env do repositorio.
#  Os valores reais vao em:
#      Vercel > projeto hub-auditoria-sanpaolo > Settings > Environment Variables
#  marcando os 3 ambientes: Production, Preview e Development.
#
#  Onde achar os valores:
#      Firebase Console > Configuracoes do projeto (engrenagem) >
#      Seus apps > App da Web > Configuracao do SDK > Config
#
#  ------------------------------ LEIA ISTO ----------------------------------
#  NENHUM valor abaixo e secreto. Todos sao entregues ao navegador de qualquer
#  visitante dentro de /js/firebase-config.js. Usar env var aqui serve para:
#     (a) nao fixar um projeto Firebase dentro do codigo-fonte;
#     (b) poder apontar Preview para um projeto de teste;
#     (c) trocar de projeto sem reescrever arquivo.
#  NAO serve para esconder credencial - e impossivel esconder.
#
#  A protecao real dos dados e, nesta ordem:
#     1. Firestore Security Rules
#     2. Firebase Authentication
#     3. restricao da chave por referenciador HTTP no Google Cloud Console
#
#  Segredo DE VERDADE (service account do Admin SDK, token de API) NAO pode
#  passar por este script: iria parar dentro de um .js publico.
#
#  NUNCA commite um .env preenchido. O .gitignore ja bloqueia .env*.
# =============================================================================

# Chave da API Web. Formato: comeca com "AIza", 39 caracteres.
FIREBASE_API_KEY=AIzaSy_substitua_pela_chave_real

# Dominio do handshake de login. Padrao: <projectId>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=san-paolo-auditoria.firebaseapp.com

# Id do projeto. Decide QUAL banco Firestore a aplicacao le e escreve.
FIREBASE_PROJECT_ID=san-paolo-auditoria

# Bucket do Cloud Storage. Padrao: <projectId>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=san-paolo-auditoria.firebasestorage.app

# Numero do Cloud Messaging. Somente digitos.
# E o mesmo numero que aparece no meio do FIREBASE_APP_ID.
FIREBASE_MESSAGING_SENDER_ID=000000000000

# Id desta aplicacao Web. Formato: 1:<messagingSenderId>:web:<hexadecimal>
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
