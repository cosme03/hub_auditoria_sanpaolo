rules_version = '2';

// ============================================================================
//  Hub Auditoria San Paolo — projeto: san-paolo-auditoria
//
//  Cobre exatamente as 4 colecoes que o app usa:
//    tarefas_equipe, auditoria_planejamento, auditoria_mapeamento, users
//
//  PREMISSA: o app autentica por Firebase Authentication (e-mail/senha) e o
//  perfil de cada pessoa vive em users/{uid}, com o ID DO DOCUMENTO igual ao
//  uid do Auth. Publicar isto antes de o login novo estar no ar derruba o
//  sistema inteiro, comecando pela leitura do proprio perfil.
//
//  POR QUE NAO BASTA "request.auth != null":
//  no Firebase Auth padrao nao ha como desligar o auto-cadastro mantendo o
//  login por e-mail/senha, e a apiKey Web e publica no bundle. Qualquer pessoa
//  na internet cria uma conta valida neste projeto. O portao real e
//  exists(users/{uid}) com ativo == true — ou seja, alguem precisa ter
//  liberado aquela conta.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------- HELPERS ----------------------------------
    function perfilPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function temPerfil() {
      return request.auth != null && exists(perfilPath());
    }
    function perfil() {
      return get(perfilPath()).data;
    }
    function ativo() {
      return temPerfil() && perfil().ativo == true;
    }
    function isSuper() {
      return ativo() && perfil().role == 'superadmin';
    }

    // Senha em texto puro nunca mais entra no Firestore.
    // Em update comparamos o DIFF: request.resource.data e o documento
    // resultante inteiro, entao um keys().hasAny() travaria para sempre
    // qualquer documento que ainda carregue um campo legado.
    function naoGravaSenha() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['pass', 'senha', 'password']);
    }

    // O dono do perfil nunca edita a propria autorizacao.
    function naoTocaCamposDeAdmin() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'ativo', 'email', 'displayName']);
    }

    // ------------------------- users/{uid} ---------------------------------
    // O id do documento DEVE ser o uid do Auth: as regras resolvem o perfil
    // por caminho literal, e nao por consulta.
    match /users/{uid} {

      // get exige apenas estar autenticado, nao ativo(): o guarda de sessao
      // precisa ler o proprio documento ANTES de saber se esta ativo.
      allow get: if request.auth != null && (request.auth.uid == uid || isSuper());

      // Listar a colecao inteira: so a tela de gestao de usuarios.
      allow list: if isSuper();

      allow create: if isSuper()
                    && !request.resource.data.keys().hasAny(['pass', 'senha', 'password'])
                    && request.resource.data.keys()
                         .hasAll(['displayName', 'email', 'role', 'ativo']);

      allow update: if (isSuper() && naoGravaSenha())
                    || (ativo()
                        && request.auth.uid == uid
                        && naoGravaSenha()
                        && naoTocaCamposDeAdmin());

      // Preferir desativar (ativo:false) a excluir: apagar a conta do Auth
      // exige Admin SDK, e remover so o perfil deixa a conta orfa. Nunca a
      // propria conta, para nao ficar sem administrador.
      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // ------------------- Dados operacionais da auditoria --------------------
    // Nao ha dono por registro: todo auditor ativo le e escreve. Mantido assim
    // de proposito, para nao mudar o comportamento atual do sistema.

    match /auditoria_planejamento/{docId} { allow read, write: if ativo(); }
    match /auditoria_mapeamento/{docId}   { allow read, write: if ativo(); }
    match /tarefas_equipe/{docId}         { allow read, write: if ativo(); }

    // --------------------------- NEGACAO EXPLICITA --------------------------
    // Documental. No Firestore uma regra so SOMA permissao, nunca remove,
    // entao este bloco nao restringe os anteriores: ele deixa o
    // deny-by-default visivel. Qualquer colecao nao citada acima fica negada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
